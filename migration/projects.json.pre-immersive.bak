      "description": {
        "hero": {
          "ar": "فندق بتفاصيل مدروسة يقدم تجربة إقامة راقية ومتوازنة في أحد أبرز مواقع الرياض",
          "en": "A thoughtfully designed hotel offering a refined and well-balanced stay experience in one of Riyadh’s prime locations"
        },
        "subtitle": {
          "ar": null,
          "en": null
        },
        "business_destination_title": {
          "ar": "وجهة أعمال متكاملة في بيئة عصرية تدعم النمو والاستدامة",
          "en": "An integrated business destination within a modern environment that supports growth and sustainability"
        },
        "business_destination_des": {
          "ar": "وجهة أعمال متطورة تجمع بين التصميم المعماري العصري والمساحات العملية المرنة، لتوفير بيئة مثالية تدعم الإنتاجية وتلبي احتياجات الشركات ورواد الأعمال. صُممت الوجهة لتواكب متطلبات السوق الحديثة وتحقق قيمة مستدامة على المدى الطويل.",
          "en": "A progressive business destination that blends contemporary architectural design with flexible, functional spaces, creating an ideal environment that enhances productivity and meets the needs of businesses and entrepreneurs while delivering long-term sustainable value."
        },
        "featured_quote": {
          "ar": null,
          "en": null
        },
        "featured_quote_content": {
          "ar": null,
          "en": null
        }
      },
