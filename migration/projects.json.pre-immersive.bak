      ],
      "description": {
        "hero": {
          "ar": "مجمع متعدد الاستخدامات مصمم ليكون مفهومًا جديدًا لمساحات الأعمال الحضرية في الرياض.",
          "en": "A mixed-use development designed to redefine urban business spaces in Riyadh."
        },
        "subtitle": {
          "ar": null,
          "en": null
        },
        "business_destination_title": {
          "ar": "وجهة متكاملة للأعمال في بيئة حضرية عصرية",
          "en": "An integrated destination for business within a modern urban environment"
        },
        "business_destination_des": {
          "ar": "وجهة أعمال متكاملة تجمع بين المساحات المكتبية الحديثة والخدمات التجارية والمرافق الداعمة، ضمن بيئة حضرية مصممة لتعزيز الإنتاجية ودعم نمو الأعمال على المدى الطويل.",
          "en": "A fully integrated business destination that brings together modern office spaces, commercial services, and supporting facilities within an urban environment designed to enhance productivity and support long-term business growth."
        },
        "featured_quote": {
          "ar": "\"وجهة الأعمال المركزية الفاخرة التي تلبي جميع تطلعاتك\"",
          "en": null
        },
        "featured_quote_content": {
          "ar": "قد رسمنا ملامح الريادة والاستثمار في هذا المشروع، لأننا نتبنى الإبداع في تطوير التصاميم التي تعزّز من هويتنا، نواصل مسيرتنا المبتكرة من خلال توفير مجموعة كبيرة من عناصر الاتصال الرأسي وذلك بمجموع 7 مصاعد .",
          "en": null
        }
      },
